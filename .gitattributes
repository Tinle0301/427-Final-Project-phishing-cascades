# Keep shell scripts LF-only. Git on Windows otherwise checks them out with
# CRLF, and bash then reads the trailing \r as part of every command:
#   data/download.sh: line 4: cd: $'data\r': No such file or directory
* text=auto

*.sh text eol=lf
*.py text eol=lf
*.gml text eol=lf
*.txt text eol=lf
